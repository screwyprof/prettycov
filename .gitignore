
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/prettycov

# Test binary, built with `go test -c`
*.test

# Coverage output
coverage.txt
coverage.html
coverage.out
coverage.tmp

# IDEs
.idea/
.vscode/

# direnv's materialised devshell (per-checkout, never committed)
/.direnv/
.envrc
.covdata/

# Checkouts surveyed while working on coverage behaviour; never part of the build.
/_reference/

# Nothing writes here since the custom linter binary went, but a clone that ran the old `make lint`
# still holds one — and GIT_LS feeds cover-branches and mutate, which would tar 150MB into /tmp.
/bin/

# Vale downloads the Google style package here; `make docs-lint` runs `vale sync` first.
/.vale/Google/
